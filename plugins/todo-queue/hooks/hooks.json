{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S \"${CLAUDE_PLUGIN_ROOT}/scripts/tq.py\" hook session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "q=\"${CLAUDE_PROJECT_DIR}/.claude/todo-queue.json\"; [ -f \"$q\" ] && grep -qE '\"status\": \"(queued|active|paused)\"' \"$q\" && python3 -S \"${CLAUDE_PLUGIN_ROOT}/scripts/tq.py\" hook user-prompt || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "TodoWrite|TaskCreate|TaskUpdate|Task|Agent|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "q=\"${CLAUDE_PROJECT_DIR}/.claude/todo-queue.json\"; [ -f \"$q\" ] && grep -q '\"intervene\": true' \"$q\" && python3 -S \"${CLAUDE_PLUGIN_ROOT}/scripts/tq.py\" hook post-tool || true",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "q=\"${CLAUDE_PROJECT_DIR}/.claude/todo-queue.json\"; [ -f \"$q\" ] && grep -q '\"intervene\": true' \"$q\" && python3 -S \"${CLAUDE_PLUGIN_ROOT}/scripts/tq.py\" hook stop || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
